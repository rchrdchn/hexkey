  "steps": [
    {
      "caption": "No tools needed",
      "say": "Clear the floor where the bed will live and lay the parts out on the empty box. This frame is held together by its joints, so put the screwdriver away.",
      "view": {
        "az": 30,
        "el": 35
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Head end",
      "say": "Stand two corner legs up, slots facing each other. Lower the head rail so its tongues slide down into the slots, both ends together, until the top is flush with the legs.",
      "add": [
        "legHL",
        "legHR",
        "endH"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 35,
        "el": 30
      }
    },
    {
      "caption": "Foot end",
      "say": "Same again at the foot end: two legs, then the foot rail slides down into their slots.",
      "add": [
        "legFL",
        "legFR",
        "endF"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": -35,
        "el": 30
      }
    },
    {
      "caption": "2 side rails in",
      "say": "Set the two ends a bed length apart. Lift a side rail and lower its tongues into the open slots at the head and the foot at the same time, then press down until it sits flush. One person at each end makes this easy. If a joint is tight, press with your palm, never hammer.",
      "add": [
        "railL",
        "railR"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 40,
        "el": 40
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Center rail",
      "say": "Drop the center rail into the notches in the middle of the head and foot rails, and stand its three legs straight so they touch the floor. Then turn the two hand-tightened screws in with your fingers until snug.",
      "add": [
        "center"
      ],
      "from": [
        0,
        30,
        0
      ],
      "hardware": [
        {
          "id": "hand",
          "axis": "-z",
          "at": [
            [
              0,
              29.97,
              -100.45
            ],
            [
              0,
              29.97,
              100.45
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Check the joints",
      "say": "Press down on each corner. Every rail should sit flush with the top of its legs, with no gap in any slot. Measure corner to corner both ways: when the diagonals match, the frame is square.",
      "view": {
        "az": 0,
        "el": 75
      }
    },
    {
      "caption": "Unroll 20 slats",
      "say": "Unroll the slats from the head to the foot. Seat the ends on the ledges inside the side rails so they lock in place and cannot slide. Twenty slats, evenly spaced.",
      "add": [
        "slats"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Mattress on",
      "say": "Push the bed into place, check that nothing rocks, and lay the mattress on. No box spring needed.",
      "view": {
        "az": 25,
        "el": 25
      }
    }
  ],
  "done": "Done. Your CLASSIC BED bed frame, king is built. Give it a proud little pat.",
  "notes": "Brand page: Classic Bed frame 13\" H with 9\" of under-bed space; solid upcycled wood with exposed Japanese joinery, tool-free assembly, pieces slide into place; felt-lined slats that lock in place; materials list mentions two hand-tightened screws. Leg size, rail tongues, the center rail's legs and where the two screws go are our best guess."
