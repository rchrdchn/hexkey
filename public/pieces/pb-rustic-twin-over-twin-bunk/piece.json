  "steps": [
    {
      "caption": "Unbox + count",
      "say": "Build it in the room it will live in. Spread the parts out on the empty boxes and check the hardware bags against the parts list first.",
      "view": {
        "az": 30,
        "el": 30
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Head end + low rails",
      "say": "Stand the head end frame up and bolt the two lower side rails to it, one at the back and one at the front. Slat ledges face in. Hand tight for now.",
      "add": [
        "endH",
        "railLB",
        "railLF"
      ],
      "from": [
        0,
        0,
        40
      ],
      "hardware": [
