            ],
            [
              91.2,
              23.9,
              51
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": -35,
        "el": 25
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Upper rails. 8 bolts.",
      "say": "Now the top bunk. Lift each upper side rail into place between the end frames and bolt both ends. Use a step stool, not the bed, to reach.",
      "add": [
        "railUB",
        "railUF"
      ],
      "from": [
        0,
        30,
        0
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "+x",
          "at": [
            [
              -91.2,
              120.1,
              -51
            ],
            [
              -91.2,
              120.1,
              51
            ]
          ],
          "spin": true
        },
        {
          "id": "bolt",
          "axis": "-x",
          "at": [
            [
              91.2,
              120.1,
              -51
            ],
            [
              91.2,
              120.1,
              51
            ]
          ],
          "spin": true
        },
        {
          "id": "bolt",
          "axis": "+y",
          "count": 4
        }
      ],
      "view": {
        "az": 30,
        "el": 20
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Square, then tighten",
      "say": "Measure corner to corner across the frame both ways. When the diagonals match it is square. Now tighten every bolt, firmly.",
      "view": {
        "az": 0,
        "el": 75
      }
    },
    {
      "caption": "2 support bars",
      "say": "Drop the metal support bars in down the middle, end frame to end frame, and screw each one in. They keep the slats from sagging.",
      "add": [
        "barL",
        "barU"
      ],
      "from": [
        0,
        25,
        0
      ],
      "hardware": [
        {
          "id": "screw",
          "axis": "+y",
          "count": 4
        }
      ],
      "view": {
        "az": 30,
        "el": 50
      }
    },
    {
      "caption": "Lower slats (14)",
      "say": "Unroll the lower slat roll across the ledges and screw or clip the ends down. Fourteen slats, evenly spaced.",
      "add": [
        "slatsL"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 45
      }
    },
    {
      "caption": "Upper slats (14)",
      "say": "Same up top: unroll the slats across the upper ledges and fix both ends. Fourteen slats. Check none of them can slide out.",
      "add": [
        "slatsU"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Guard rails on",
      "say": "Bolt the long guard rail along the back of the top bunk, and the short one along the front, leaving the gap for the ladder. Both sides of the top get a rail, even against a wall.",
      "add": [
        "guardB",
        "guardF"
      ],
      "from": [
        0,
        25,
        0
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "+y",
          "count": 8
        }
      ],
      "view": {
        "az": 25,
        "el": 30
      },
      "safety": "Never leave off a guard rail."
    },
    {
      "caption": "Ladder on",
      "say": "Hook the ladder over the front rail in the gap and bolt it on at the top. Its feet sit flat on the floor.",
      "add": [
        "ladder"
      ],
      "from": [
        0,
        0,
        35
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "-z",
          "at": [
            [
              48.2,
              120.1,
              55
            ],
            [
              84.2,
              120.1,
              55
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": -20,
        "el": 20
      }
    },
    {
      "caption": "Anchor it",
      "say": "Push the bed against a wall and give it a firm shake: nothing should rock or creak. A tall bed is top-heavy, so anchor it to the wall with fixings for your wall. The top bunk is not for children under six.",
      "hardware": [
        {
          "id": "anchor",
          "axis": "-z",
          "at": [
            [
              -49.85,
