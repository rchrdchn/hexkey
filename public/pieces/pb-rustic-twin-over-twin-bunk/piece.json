              -51
            ],
            [
              -91.2,
              23.9,
              51
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": 35,
        "el": 25
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Foot end. 4 bolts.",
      "say": "Bring in the foot end frame and bolt the free ends of the rails to it. A helper holds the frame upright while you start each bolt.",
      "add": [
        "endF"
      ],
      "from": [
        40,
        0,
        0
      ],
      "hardware": [
        {
