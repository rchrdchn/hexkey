  "steps": [
    {
      "caption": "No tools needed",
      "say": "Clear the floor where the bed will go. This frame goes together with no tools and no screws: just supports, panels and straps.",
      "view": {
        "az": 30,
        "el": 40
      }
    },
    {
      "caption": "Set out 12 supports",
      "say": "Stand the steel supports on the floor in a grid, four across and three from head to foot. Use a panel as a spacer so the gaps come out right.",
      "add": [
        "supports"
      ],
      "from": [
        0,
        25,
        0
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Head-end panels",
      "say": "Lay the first three panels across the head-end supports, good side up, edges tight together.",
      "add": [
        "p1_1",
        "p1_2",
        "p1_3"
      ],
      "from": [
        0,
        30,
        0
