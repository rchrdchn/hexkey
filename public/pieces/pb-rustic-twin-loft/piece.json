              50.65,
              174.8,
              -55.55
            ]
          ]
        }
      ],
      "view": {
        "az": 150,
        "el": 25,
        "tight": true,
        "zoom": 0.8
      },
      "safety": "Tip-over risk. Always anchor to the wall."
    }
