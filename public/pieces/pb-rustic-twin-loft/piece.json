              134.3,
              51
            ],
            [
              -92.8,
              141.3,
              -51
            ],
            [
              -92.8,
              141.3,
              51
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": 35,
        "el": 25
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Foot end. 4 bolts.",
      "say": "Bring in the foot end frame and bolt the free ends of the rails to it. A helper holds the frame upright while you start each bolt.",
      "add": [
        "endF"
      ],
      "from": [
        40,
        0,
        0
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "-x",
          "at": [
            [
              92.8,
              134.3,
              -51
            ],
            [
              92.8,
              134.3,
              51
            ],
            [
              92.8,
              141.3,
              -51
            ],
            [
              92.8,
              141.3,
              51
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": -35,
        "el": 25
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Square, then tighten",
      "say": "Measure corner to corner across the frame both ways. When the diagonals match it is square. Now tighten every bolt, firmly.",
      "view": {
        "az": 0,
        "el": 75
      }
    },
    {
      "caption": "Support bar",
      "say": "Drop the metal support bar in down the middle, end frame to end frame, and screw it in. It keeps the slats from sagging.",
      "add": [
        "barU"
      ],
      "from": [
        0,
        25,
        0
      ],
      "hardware": [
        {
          "id": "screw",
          "axis": "+y",
          "count": 2
        }
      ],
      "view": {
        "az": 30,
        "el": 50
      }
    },
    {
      "caption": "Slats (14)",
      "say": "Unroll the slats across the ledges and fix both ends. Fourteen slats. Check none of them can slide out.",
      "add": [
        "slatsU"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Guard rails on",
      "say": "Bolt the long guard rail along the back of the bed, and the short one along the front, leaving the gap for the ladder. Both sides of the top get a rail, even against a wall.",
      "add": [
        "guardB",
        "guardF"
      ],
      "from": [
        0,
        25,
        0
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "+y",
          "count": 8
        }
      ],
      "view": {
        "az": 25,
        "el": 30
      },
      "safety": "Never leave off a guard rail."
    },
    {
      "caption": "Ladder on",
      "say": "Hook the ladder over the front rail in the gap and bolt it on at the top. Its feet sit flat on the floor.",
      "add": [
        "ladder"
      ],
      "from": [
        0,
        0,
        35
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "-z",
          "at": [
            [
              49.8,
              137.8,
              55
            ],
            [
              85.8,
              137.8,
              55
            ]
          ],
          "spin": true
        }
      ],
      "view": {
        "az": -20,
        "el": 20
      }
    },
    {
      "caption": "Anchor it",
      "say": "Push the bed against a wall and give it a firm shake: nothing should rock or creak. A tall bed is top-heavy, so anchor it to the wall with fixings for your wall. The top is not for children under six.",
      "hardware": [
        {
          "id": "anchor",
          "axis": "-z",
          "at": [
            [
              -50.65,
              174.8,
