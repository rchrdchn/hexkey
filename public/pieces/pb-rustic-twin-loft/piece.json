  "steps": [
    {
      "caption": "Unbox + count",
      "say": "Open the boxes in the bedroom, the frame will not fit through a door once it is built. Lay every part on the flattened cartons and count the bolts against the parts list.",
      "view": {
        "az": 30,
        "el": 30
      },
      "safety": "Two people for this one."
    },
    {
      "caption": "Head end + rails",
      "say": "Stand the head end frame up and bolt the two side rails to it, one at the back and one at the front. These carry the bed, so the slat ledges face in. Hand tight for now.",
      "add": [
        "endH",
        "railUB",
        "railUF"
      ],
      "from": [
        0,
        0,
        40
      ],
      "hardware": [
        {
          "id": "bolt",
          "axis": "+x",
          "at": [
            [
              -92.8,
              134.3,
              -51
            ],
            [
