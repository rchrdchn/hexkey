  "steps": [
    {
      "caption": "No tools needed",
      "say": "Clear the floor where the bed will go. This frame goes together with no tools and no screws: just supports, panels and straps.",
      "view": {
        "az": 30,
        "el": 40
      }
    },
    {
      "caption": "Set out 15 supports",
      "say": "Stand the steel supports on the floor in a grid, five across and three from head to foot. Use a panel as a spacer so the gaps come out right.",
      "add": [
        "supports"
      ],
      "from": [
        0,
        25,
        0
      ],
      "view": {
        "az": 30,
        "el": 55
      }
    },
    {
      "caption": "Head-end panels",
      "say": "Lay the first four panels across the head-end supports, good side up, edges tight together.",
      "add": [
        "p1_1",
        "p1_2",
        "p1_3",
        "p1_4"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 50
      },
      "safety": "Two people make this easier."
    },
    {
      "caption": "Foot-end panels",
      "say": "Next row of panels, butted tight against the first. Nudge the supports under the joints if they have drifted.",
      "add": [
        "p2_1",
        "p2_2",
        "p2_3",
        "p2_4"
      ],
      "from": [
        0,
        30,
        0
      ],
      "view": {
        "az": 30,
        "el": 50
      }
    },
    {
      "caption": "Ratchet the straps",
      "say": "Run each ratchet strap round the supports and panels, three in all, and crank them until the panels pull tight with no gaps. Snug is enough, the straps only stop things shifting.",
      "add": [
        "straps"
      ],
      "from": [
        0,
        20,
        0
      ],
      "view": {
        "az": 25,
        "el": 35
      }
    },
    {
      "caption": "Mattress on",
      "say": "Push the bed into place, press on each corner to check nothing rocks, and lay the mattress on. No box spring needed.",
      "view": {
        "az": 25,
        "el": 25
      }
    }
  ],
